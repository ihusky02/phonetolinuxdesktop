<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <add key="local-packages" value="./nupkgs" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="local-packages">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
