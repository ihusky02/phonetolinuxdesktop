<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:phonetolinux.ViewModels"
        xmlns:local="using:phonetolinux"
        xmlns:d="http://schemas.openxmlformats.org/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:views="using:phonetolinux.Views"
        mc:Ignorable="d" 
        x:Class="phonetolinux.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        x:Name="RootWindow"
        Title="phonetolinux"
        Width="1000" Height="680"
        MinWidth="750" MinHeight="500"
        CanResize="True"
        SystemDecorations="Full"
        Topmost="False"
        WindowStartupLocation="CenterScreen"
        TransparencyLevelHint="AcrylicBlur, Blur, Transparent"
        Background="#CC121212"
        KeyDown="Window_KeyDown">

    <Window.Resources>
        <local:MessageBgConverter x:Key="MessageBgConverter"/>
        <local:MessageAlignConverter x:Key="MessageAlignConverter"/>
        <local:TabHighlightConverter x:Key="TabHighlightConverter"/>
    </Window.Resources>

    <Grid RowDefinitions="32, *">
        <!-- CUSTOM TITLE BAR -->
        <Grid Grid.Row="0" Background="#CC181818" ColumnDefinitions="*, Auto" PointerPressed="TitleBar_PointerPressed">
            <TextBlock Grid.Column="0" Text="phonetolinux" Foreground="#AAAAAA" FontSize="12" VerticalAlignment="Center" Margin="10,0,0,0"/>
            
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Content="—" Width="36" Height="32" Background="Transparent" Foreground="White" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Click="Minimize_Click"/>
                <Button Content="🗖" Width="36" Height="32" Background="Transparent" Foreground="White" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Click="Maximize_Click"/>
                <Button Content="✕" Width="36" Height="32" Background="Transparent" Foreground="#FF5555" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Click="Close_Click"/>
            </StackPanel>
        </Grid>

        <!-- MAIN WINDOW CONTENT -->
        <Grid Grid.Row="1">
            
            <!-- WORKSPACE WHEN PAIRED (IsPaired == True) -->
            <Grid ColumnDefinitions="64, *" IsVisible="{Binding IsPaired}">
                
                <!-- LEFT NAVIGATION RAIL -->
                <Border Grid.Column="0" Background="#CC181818" BorderBrush="#2A2A2A" BorderThickness="0,0,1,0">
                    <Grid RowDefinitions="*, Auto">
                        <StackPanel Grid.Row="0" Spacing="8" Margin="0,12,0,0" HorizontalAlignment="Center">
                            <!-- Dialer Button (Index 0) -->
                            <Button Width="48" Height="48" CornerRadius="12" ToolTip.Tip="Dialer"
                                    Command="{Binding SelectTabCommand}" CommandParameter="0"
                                    Background="{Binding SelectedTabIndex, Converter={StaticResource TabHighlightConverter}, ConverterParameter=0}">
                                <PathIcon Data="M6.62 10.79c1.44 2.83 3.76 5.14 6.59 6.59l2.2-2.2c.27-.27.67-.36 1.02-.24 1.12.37 2.33.57 3.57.57.55 0 1 .45 1 1V20c0 .55-.45 1-1 1-9.39 0-17-7.61-17-17 0-.55.45-1 1-1h3.5c.55 0 1 .45 1 1 0 1.25.2 2.45.57 3.57.11.35.03.74-.25 1.02l-2.2 2.2z" 
                                          Foreground="#4CAF50" 
                                          Width="22" Height="22" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Button>

                            <!-- Contacts / Address Book Button (Index 1) -->
                            <Button Width="48" Height="48" CornerRadius="12" ToolTip.Tip="Contacts"
                                    Command="{Binding SelectTabCommand}" CommandParameter="1"
                                    Background="{Binding SelectedTabIndex, Converter={StaticResource TabHighlightConverter}, ConverterParameter=1}">
                                <PathIcon Data="M19 3H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zm-7 3c1.66 0 3 1.34 3 3s-1.34 3-3 3-3-1.34-3-3 1.34-3 3-3zm6 12H6v-1c0-2 4-3.1 6-3.1s6 1.1 6 3.1v1z" 
                                          Foreground="#42A5F5" 
                                          Width="22" Height="22" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Button>

                            <!-- Chat Button (Index 2) -->
                            <Button Width="48" Height="48" CornerRadius="12" ToolTip.Tip="Chat"
                                    Command="{Binding SelectTabCommand}" CommandParameter="2"
                                    Background="{Binding SelectedTabIndex, Converter={StaticResource TabHighlightConverter}, ConverterParameter=2}">
                                <PathIcon Data="M20 2H4c-1.1 0-2 .9-2 2v18l4-4h14c1.1 0 2-.9 2-2V4c0-1.1-.9-2-2-2zm-2 12H6v-2h12v2zm0-3H6V9h12v2zm0-3H6V6h12v2z" 
                                          Foreground="#29B6F6" 
                                          Width="22" Height="22" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Button>
                            
                            <!-- Storage / Device Storage Button (Index 4) -->
                            <Button Width="48" Height="48" CornerRadius="12" ToolTip.Tip="Device Storage"
                                    Command="{Binding SelectTabCommand}" CommandParameter="4"
                                    Background="{Binding SelectedTabIndex, Converter={StaticResource TabHighlightConverter}, ConverterParameter=4}">
                                <PathIcon Data="M10 4H4C2.9 4 2.01 4.9 2.01 6L2 18C2 19.1 2.9 20 4 20H20C21.1 20 22 19.1 22 18V8C22 6.9 21.1 6 20 6H12L10 4Z" 
                                          Foreground="Orange" 
                                          Width="22" Height="22" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Button>
                        </StackPanel>

                        <!-- Settings Button (Bottom Rail, Index 3) -->
                        <Button Grid.Row="1" Width="48" Height="48" CornerRadius="12" Margin="0,0,0,12" ToolTip.Tip="Settings"
                                HorizontalAlignment="Center"
                                Command="{Binding SelectTabCommand}" CommandParameter="3"
                                Background="{Binding SelectedTabIndex, Converter={StaticResource TabHighlightConverter}, ConverterParameter=3}">
                            <PathIcon Data="M19.14 12.94c.04-.3.06-.61.06-.94 0-.32-.02-.64-.07-.94l2.03-1.58c.18-.14.23-.41.12-.61l-1.92-3.32c-.12-.22-.37-.29-.59-.22l-2.39.96c-.5-.38-1.03-.7-1.62-.94l-.36-2.54c-.04-.24-.24-.41-.48-.41h-3.84c-.24 0-.43.17-.47.41l-.36 2.54c-.59.24-1.13.57-1.62.94l-2.39-.96c-.22-.08-.47 0-.59.22L2.74 8.87c-.12.21-.08.47.12.61l2.03 1.58c-.05.3-.09.63-.09.94s.02.64.07.94l-2.03 1.58c-.18.14-.23.41-.12.61l1.92 3.32c.12.22.37.29.59.22l2.39-.96c.5.38 1.03.7 1.62.94l.36 2.54c.05.24.24.41.48.41h3.84c.24 0 .44-.17.47-.41l.36-2.54c.59-.24 1.13-.56 1.62-.94l2.39.96c.22.08.47 0 .59-.22l1.92-3.32c.12-.22.07-.47-.12-.61l-2.01-1.58zM12 15.6c-1.98 0-3.6-1.62-3.6-3.6s1.62-3.6 3.6-3.6 3.6 1.62 3.6 3.6-1.62 3.6-3.6 3.6z" 
                                      Foreground="#9CA3AF" 
                                      Width="22" Height="22" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Button>
                    </Grid>
                </Border>
                        
                <!-- RIGHT PANEL - TAB CONTENT CAROUSEL -->
                <Carousel Grid.Column="1" SelectedIndex="{Binding SelectedTabIndex}">
                    
                    <!-- TAB 0: DIALER -->
                    <Grid RowDefinitions="Auto, *, Auto" Margin="10">
                        <TextBlock Grid.Row="0" Text="{Binding PhoneNumber}" FontSize="38" Foreground="White"
                                   TextAlignment="Center" Margin="0,20,0,10" MinHeight="50"/>

                        <UniformGrid Grid.Row="1" Columns="3" Rows="4" Margin="10">
                            <UniformGrid.Styles>
                                <Style Selector="Button">
                                    <Setter Property="FontSize" Value="24"/>
                                    <Setter Property="Foreground" Value="White"/>
                                    <Setter Property="Background" Value="#CC2C2C2C"/>
                                    <Setter Property="CornerRadius" Value="35"/>
                                    <Setter Property="HorizontalAlignment" Value="Stretch"/>
                                    <Setter Property="VerticalAlignment" Value="Stretch"/>
                                    <Setter Property="Margin" Value="6"/>
                                    <Setter Property="HorizontalContentAlignment" Value="Center"/>
                                    <Setter Property="VerticalContentAlignment" Value="Center"/>
                                </Style>
                            </UniformGrid.Styles>

                            <Button Content="1" Command="{Binding AppendNumberCommand}" CommandParameter="1"/>
                            <Button Content="2" Command="{Binding AppendNumberCommand}" CommandParameter="2"/>
                            <Button Content="3" Command="{Binding AppendNumberCommand}" CommandParameter="3"/>
                            <Button Content="4" Command="{Binding AppendNumberCommand}" CommandParameter="4"/>
                            <Button Content="5" Command="{Binding AppendNumberCommand}" CommandParameter="5"/>
                            <Button Content="6" Command="{Binding AppendNumberCommand}" CommandParameter="6"/>
                            <Button Content="7" Command="{Binding AppendNumberCommand}" CommandParameter="7"/>
                            <Button Content="8" Command="{Binding AppendNumberCommand}" CommandParameter="8"/>
                            <Button Content="9" Command="{Binding AppendNumberCommand}" CommandParameter="9"/>
                            <Button Content="*" Command="{Binding AppendNumberCommand}" CommandParameter="*"/>
                            <Button Content="0" Command="{Binding AppendNumberCommand}" CommandParameter="0"/>
                            <Button Content="#" Command="{Binding AppendNumberCommand}" CommandParameter="#"/>
                        </UniformGrid>

                        <Grid Grid.Row="2" ColumnDefinitions="*, *, *" Margin="0,5,0,15">
                            <Button Grid.Column="1" Background="#4CAF50" CornerRadius="35"
                                    HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                    Height="70" Width="70" Command="{Binding CallCommand}">
                                <Path Data="M6.62 10.79c1.44 2.83 3.76 5.14 6.59 6.59l2.2-2.2c.27-.27.67-.36 1.02-.24 1.12.37 2.33.57 3.57.57.55 0 1 .45 1 1V20c0 .55-.45 1-1 1-9.39 0-17-7.61-17-17 0-.55.45-1 1-1h3.5c.55 0 1 .45 1 1 0 1.25.2 2.45.57 3.57.11.35.03.74-.25 1.02l-2.2 2.2z" 
                                      Fill="White" Width="24" Height="24" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Button>

                            <Button Grid.Column="2" Background="Transparent" Foreground="White" FontSize="22"
                                    Command="{Binding BackspaceCommand}" HorizontalAlignment="Center" VerticalAlignment="Center">
                                ⌫
                            </Button>
                        </Grid>
                    </Grid>

                    <!-- TAB 1: CONTACTS -->
                    <Grid Margin="10" RowDefinitions="Auto, *">
                        <TextBlock Grid.Row="0" Text="{Binding SearchQuery, StringFormat='Search: {0} ⌫'}"
                                   IsVisible="{Binding IsSearchActive}" Foreground="#4CAF50" FontSize="14"
                                   Margin="0,0,0,10" HorizontalAlignment="Center" FontWeight="SemiBold"/>

                        <ScrollViewer Grid.Row="1">
                            <ItemsControl ItemsSource="{Binding ContactsList}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="#CC1A1A1A" BorderBrush="#333333" BorderThickness="1" CornerRadius="8" Margin="0,0,0,10" Padding="12">
                                            <Grid ColumnDefinitions="*, Auto">
                                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Name}" Foreground="White" FontSize="15" FontWeight="SemiBold"/>
                                                    <TextBlock Text="{Binding PhoneNumber}" Foreground="#AAAAAA" FontSize="12" Margin="0,3,0,0"/>
                                                </StackPanel>

                                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                                    <Button Width="42" Height="40" Background="#1E88E5" CornerRadius="20"
                                                            Command="{Binding #RootWindow.DataContext.SendMessageToContactCommand}" CommandParameter="{Binding PhoneNumber}">
                                                        <Path Data="M20 2H4c-1.1 0-2 .9-2 2v18l4-4h14c1.1 0 2-.9 2-2V4c0-1.1-.9-2-2-2z" Fill="White" Width="18" Height="18" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Button>

                                                    <Button Width="42" Height="40" Background="#2E7D32" CornerRadius="20"
                                                            Command="{Binding #RootWindow.DataContext.CallSpecificNumberCommand}" CommandParameter="{Binding PhoneNumber}">
                                                        <Path Data="M6.62 10.79c1.44 2.83 3.76 5.14 6.59 6.59l2.2-2.2c.27-.27.67-.36 1.02-.24 1.12.37 2.33.57 3.57.57.55 0 1 .45 1 1V20c0 .55-.45 1-1 1-9.39 0-17-7.61-17-17 0-.55.45-1 1-1h3.5c.55 0 1 .45 1 1 0 1.25.2 2.45.57 3.57.11.35.03.74-.25 1.02l-2.2 2.2z" Fill="White" Width="16" Height="16" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Button>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>

                    <!-- TAB 2: CHAT -->
                    <Grid ColumnDefinitions="320, *" Margin="10">
                        <Border Grid.Column="0" BorderBrush="#333333" BorderThickness="0,0,1,0" Margin="0,0,10,0">
                            <ListBox ItemsSource="{Binding RecentConversations}"
                                     SelectedItem="{Binding SelectedConversation}"
                                     Background="Transparent">
                                <ListBox.Styles>
                                    <Style Selector="ListBoxItem">
                                        <Setter Property="CornerRadius" Value="8"/>
                                        <Setter Property="Padding" Value="10,8"/>
                                        <Setter Property="Margin" Value="0,2,6,2"/>
                                        <Setter Property="Background" Value="Transparent"/>
                                    </Style>
                                    <Style Selector="ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
                                        <Setter Property="Background" Value="#1AFFFFFF"/>
                                    </Style>
                                    <Style Selector="ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
                                        <Setter Property="Background" Value="#253545"/>
                                    </Style>
                                </ListBox.Styles>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Background="Transparent">
                                            <Grid.ContextMenu>
                                                <ContextMenu>
                                                    <MenuItem Header="Delete Chat" 
                                                              Command="{Binding #RootWindow.DataContext.DeleteConversationCommand}" 
                                                              CommandParameter="{Binding}" />
                                                </ContextMenu>
                                            </Grid.ContextMenu>
                                            
                                            <StackPanel Spacing="4" HorizontalAlignment="Stretch">
                                                <TextBlock Text="{Binding ContactName, FallbackValue='Nieznany'}" 
                                                           Foreground="#64B5F6" 
                                                           FontWeight="Bold" 
                                                           FontSize="14" 
                                                           TextTrimming="CharacterEllipsis"/>
                                                
                                                <TextBlock Text="{Binding LastMessage, FallbackValue=''}" 
                                                           Foreground="#CCCCCC" 
                                                           FontSize="12" 
                                                           TextTrimming="CharacterEllipsis" 
                                                           MaxLines="1"/>
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Border>

                        <Grid Grid.Column="1" RowDefinitions="*, Auto">
                            <ScrollViewer Grid.Row="0" Margin="0,0,0,10" VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding MessagesList}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="{Binding IsOutgoing, Converter={StaticResource MessageBgConverter}, FallbackValue=#2E7D32}"
                                                    CornerRadius="12" Padding="10,8" Margin="4" MaxWidth="360"
                                                    HorizontalAlignment="{Binding IsOutgoing, Converter={StaticResource MessageAlignConverter}, FallbackValue=Right}">
                                                <TextBlock Text="{Binding Text}" Foreground="White" TextWrapping="Wrap" FontSize="14"/>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>

                            <!-- TEXTBOX INPUT GRID -->
                            <Grid Grid.Row="1" ColumnDefinitions="Auto, *, Auto, Auto">
                                <Button Grid.Column="0" Content="📎" Background="Transparent" Foreground="White" FontSize="18" Margin="0,0,4,0" ToolTip.Tip="Attach File"/>
                                
                                <TextBox Grid.Column="1" Text="{Binding CurrentMessageText, Mode=TwoWay}" Watermark="Type a message..." 
                                         Background="#CC2C2C2C" Foreground="White" CaretBrush="White" BorderBrush="#444444" CornerRadius="8" Margin="0,0,4,0"/>
                                
                                <Button Grid.Column="2" Content="😀" Background="Transparent" Foreground="White" FontSize="18" Margin="0,0,6,0" ToolTip.Tip="Insert Emoji"/>

                                <Button Grid.Column="3" Content="Send" Background="#1E88E5" Foreground="White" CornerRadius="8" Padding="12,8" Command="{Binding SendMessageCommand}"/>
                            </Grid>
                        </Grid>
                    </Grid>

                    <!-- TAB 3: SETTINGS -->
                    <Grid Margin="20">
                        <StackPanel Spacing="16" HorizontalAlignment="Stretch" VerticalAlignment="Top">
                            <TextBlock Text="⚙️ Phonetolinux Settings" FontSize="20" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" Margin="0,0,0,10"/>
        
                            <!-- Settings List -->
                            <Border Background="#CC1E1E1E" CornerRadius="8" Padding="16" HorizontalAlignment="Stretch">
                                <StackPanel Spacing="16" HorizontalAlignment="Stretch">
                
                                    <!-- Row 1: Unpair Device -->
                                    <Grid ColumnDefinitions="Auto, *, Auto" HorizontalAlignment="Stretch">
                                        <!-- Left side: Warning icon + Status text -->
                                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center" HorizontalAlignment="Left">
                                            <TextBlock Text="⚠️" FontSize="20" VerticalAlignment="Center"/>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="Device Connection" FontWeight="Bold" Foreground="White"/>
                                                <TextBlock Text="Paired device is active" Foreground="#4CAF50" FontSize="12"/>
                                            </StackPanel>
                                        </StackPanel>
                    
                                        <!-- Right side: Unpair button -->
                                        <Button Grid.Column="2" 
                                                Content="Unpair" 
                                                Command="{Binding UnpairDeviceCommand}" 
                                                Background="#E53935" 
                                                Foreground="White" 
                                                VerticalAlignment="Center" 
                                                HorizontalAlignment="Right"
                                                Padding="16,6"/>
                                    </Grid>

                                    <Rectangle Height="1" Fill="#2A2A2A" HorizontalAlignment="Stretch"/>

                                    <!-- Row 2: Theme Switcher (Inactive) -->
                                    <Grid ColumnDefinitions="Auto, *, Auto" HorizontalAlignment="Stretch">
                                        <!-- Left side: Theme icon + Description -->
                                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center" HorizontalAlignment="Left">
                                            <TextBlock Text="🌗" FontSize="20" VerticalAlignment="Center"/>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="App Theme" FontWeight="Bold" Foreground="White"/>
                                                <TextBlock Text="Toggle Dark / Light mode (Coming soon)" Foreground="#888888" FontSize="12"/>
                                            </StackPanel>
                                        </StackPanel>
                    
                                        <!-- Right side: ToggleSwitch (Disabled for now) -->
                                        <ToggleSwitch Grid.Column="2" 
                                                      IsEnabled="False" 
                                                      IsChecked="True"
                                                      OffContent="" 
                                                      OnContent="" 
                                                      VerticalAlignment="Center" 
                                                      HorizontalAlignment="Right"/>
                                    </Grid>

                                    <Rectangle Height="1" Fill="#2A2A2A" HorizontalAlignment="Stretch"/>

                                    <!-- Row 3: App Version & Check for Updates -->
                                    <Grid ColumnDefinitions="Auto, *, Auto" HorizontalAlignment="Stretch">
                                        <!-- Left side: Update Icon + Version string -->
                                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center" HorizontalAlignment="Left">
                                            <TextBlock Text="🔄" FontSize="20" VerticalAlignment="Center"/>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="Application Updates" FontWeight="Bold" Foreground="White"/>
                                                <TextBlock Text="{Binding CurrentVersion, StringFormat='Version: {0}'}" Foreground="#AAAAAA" FontSize="12"/>
                                            </StackPanel>
                                        </StackPanel>
                    
                                        <!-- Right side: Check for Updates button -->
                                        <Button Grid.Column="2" 
                                                Content="Check for Updates" 
                                                Command="{Binding CheckForUpdatesCommand}" 
                                                Background="#1E88E5" 
                                                Foreground="White" 
                                                VerticalAlignment="Center" 
                                                HorizontalAlignment="Right"
                                                Padding="16,6"/>
                                    </Grid>

                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>

                    <!-- TAB 4: STORAGE (File Browser) -->
                    <Grid Margin="10">
                        <views:StorageBrowserView DataContext="{Binding StorageViewModel}" />
                    </Grid>

                </Carousel>
            </Grid>

            <!-- PAIRING SCREEN (IsPaired == False) -->
            <Grid Background="#CC121212" IsVisible="{Binding !IsPaired}">
                <Border Margin="16" Padding="24" Background="#CC1E1E1E" CornerRadius="12" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                    <Grid RowDefinitions="Auto, *, Auto, Auto">
                        <TextBlock Grid.Row="0" Text="Device Pairing" FontSize="24" FontWeight="SemiBold" Foreground="White" HorizontalAlignment="Center" Margin="0,0,0,12"/>
                        <Border Grid.Row="1" Background="#CC121212" BorderBrush="#333333" BorderThickness="1" CornerRadius="8" Padding="12" MinHeight="220">
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="10">
                                <TextBlock Text="ENTER THIS PIN ON YOUR PHONE:" FontSize="12" Foreground="#888888" HorizontalAlignment="Center"/>
                                <TextBlock Text="{Binding Pairing.PairingPin}" FontFamily="Monospace" FontSize="42" FontWeight="Bold" Foreground="#FFEB3B" HorizontalAlignment="Center" TextAlignment="Center"/>
                            </StackPanel>
                        </Border>
                        <Border Grid.Row="2" Background="#2A2A2A" CornerRadius="6" Padding="12,10" Margin="0,12,0,12">
                            <TextBlock Text="{Binding Pairing.StatusMessage}" Foreground="#4CAF50" FontSize="14" FontWeight="Medium" TextWrapping="Wrap" TextAlignment="Center" HorizontalAlignment="Center"/>
                        </Border>
                        <Button Grid.Row="3" Content="Generate New PIN" Command="{Binding Pairing.GeneratePairingPinCommand}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Background="#333333" Foreground="White" CornerRadius="6" Padding="0,12"/>
                    </Grid>
                </Border>
            </Grid>

            <!-- CALL OVERLAY -->
            <Grid Background="#E6121212" IsVisible="{Binding IsInCall}">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <Border Width="120" Height="120" CornerRadius="60" Background="#2C2C2C" Margin="0,0,0,20">
                        <TextBlock Text="👤" FontSize="60" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#888888"/>
                    </Border>
                    <TextBlock Text="{Binding ContactName}" FontSize="26" Foreground="White" TextAlignment="Center" FontWeight="Bold"/>
                    <TextBlock Text="{Binding PhoneNumber}" FontSize="18" Foreground="#888888" TextAlignment="Center" Margin="0,8,0,50"/>
                    <StackPanel Orientation="Horizontal" Spacing="30" HorizontalAlignment="Center">
                        <Button Width="75" Height="75" Background="#E53935" CornerRadius="37" Command="{Binding EndCallCommand}" HorizontalAlignment="Center">
                            <Path Data="M12 9c-1.6 0-3.15.25-4.6.72v3.1c0 .39-.23.74-.56.9-.98.49-1.87 1.12-2.66 1.85-.18.18-.43.28-.7.28-.28 0-.53-.11-.71-.29L.29 13.08c-.18-.17-.29-.42-.29-.7 0-.28.11-.53.29-.71C3.34 8.78 7.46 7 12 7s8.66 1.78 11.71 4.67c.18.18.29.43.29.71 0 .28-.11.53-.29.71l-2.48 2.48c-.18.18-.43.29-.71.29-.27 0-.52-.1-.7-.28-.79-.73-1.68-1.36-2.66-1.85-.33-.16-.56-.51-.56-.9v-3.1C15.15 9.25 13.6 9 12 9z" Fill="White" Width="28" Height="28" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Button>
                        <Button Width="75" Height="75" Background="#4CAF50" CornerRadius="37" Command="{Binding AnswerCallCommand}" IsVisible="{Binding IsIncomingCall}" HorizontalAlignment="Center">
                            <Path Data="M6.62 10.79c1.44 2.83 3.76 5.14 6.59 6.59l2.2-2.2c.27-.27.67-.36 1.02-.24 1.12.37 2.33.57 3.57.57.55 0 1 .45 1 1V20c0 .55-.45 1-1 1-9.39 0-17-7.61-17-17 0-.55.45-1 1-1h3.5c.55 0 1 .45 1 1 0 1.25.2 2.45.57 3.57.11.35.03.74-.25 1.02l-2.2 2.2z" Fill="White" Width="26" Height="26" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </Grid>

        </Grid>
    </Grid>
</Window>