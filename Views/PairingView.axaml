<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.openxmlformats.org/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:phonetolinux.ViewModels"
             mc:Ignorable="d" d:DesignWidth="600" d:DesignHeight="700"
             x:Class="phonetolinux.Views.PairingView"
             x:DataType="vm:PairingViewModel">

    <UserControl.DataContext>
        <vm:PairingViewModel/>
    </UserControl.DataContext>

    <!-- Main container taking up full available space with margins -->
    <Border Margin="16" Padding="24" Background="#1E1E1E" CornerRadius="12" 
            HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
        
        <Grid RowDefinitions="Auto, *, Auto, Auto" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
            
            <!-- Title -->
            <TextBlock Grid.Row="0" Text="Device Pairing" 
                       FontSize="24" 
                       FontWeight="SemiBold" 
                       Foreground="White" 
                       HorizontalAlignment="Center"
                       Margin="0,0,0,12"/>

            <!-- Secure 6-digit PIN container -->
            <Border Grid.Row="1" Background="#121212" BorderBrush="#333333" BorderThickness="1" 
                    CornerRadius="8" Padding="12" 
                    HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="10">
                    <TextBlock Text="ENTER THIS PIN ON YOUR PHONE:" 
                               FontSize="12" 
                               Foreground="#888888" 
                               HorizontalAlignment="Center"/>
                    
                    <TextBlock Text="{Binding PairingPin}" 
                               FontFamily="Monospace" 
                               FontSize="42" 
                               FontWeight="Bold"
                               Foreground="#FFEB3B"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               TextAlignment="Center"/>
                </StackPanel>
            </Border>

            <!-- Status banner -->
            <Border Grid.Row="2" Background="#2A2A2A" CornerRadius="6" Padding="12,10" 
                    HorizontalAlignment="Stretch" Margin="0,12,0,12">
                <TextBlock Text="{Binding StatusMessage}" 
                           Foreground="#4CAF50" 
                           FontSize="14"
                           FontWeight="Medium"
                           TextWrapping="Wrap" 
                           TextAlignment="Center" 
                           HorizontalAlignment="Center"/>
            </Border>

            <!-- Refresh button stretched to full width -->
            <Button Grid.Row="3" Content="Generate New PIN" 
                    Command="{Binding GeneratePairingPinCodeCommand}" 
                    HorizontalAlignment="Stretch" 
                    HorizontalContentAlignment="Center"
                    Background="#333333"
                    Foreground="White"
                    CornerRadius="6"
                    Padding="0,12"/>

        </Grid>
    </Border>
</UserControl>