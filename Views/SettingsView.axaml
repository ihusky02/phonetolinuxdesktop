<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="phonetolinux.Views.SettingsView">

    <StackPanel Margin="20" Spacing="15">
        
        <!-- Section Header -->
        <TextBlock Text="About &amp; Updates" FontSize="18" FontWeight="Bold" />

        <!-- Version & Update Button Row -->
        <Grid ColumnDefinitions="*, Auto" VerticalAlignment="Center">
            
            <!-- App Version Info -->
            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                <TextBlock Text="Current Version" FontWeight="SemiBold" />
                <TextBlock Text="{Binding CurrentVersion}" Foreground="Gray" FontSize="12" />
            </StackPanel>

            <!-- Update Button -->
            <Button Grid.Column="1" 
                    Content="Check for Updates" 
                    Command="{Binding CheckForUpdatesCommand}" 
                    Padding="12,6" />
        </Grid>

    </StackPanel>
</UserControl>