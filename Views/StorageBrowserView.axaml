<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:models="using:phonetolinux.Models"
             x:Class="phonetolinux.Views.StorageBrowserView"
             Background="Transparent">

    <Grid RowDefinitions="Auto, *">
        
        <!-- HEADER / NAVIGATION BAR -->
        <Border Grid.Row="0" Background="#1E1E1E" CornerRadius="8" Padding="12" Margin="0,0,0,10">
            <Grid ColumnDefinitions="Auto, *, Auto">
                
                <!-- Back Button -->
                <Button Grid.Column="0" Command="{Binding NavigateUpCommand}" Background="#2C2C2C" CornerRadius="6" Width="36" Height="36" Margin="0,0,12,0" ToolTip.Tip="Go Up">
                    <PathIcon Data="M20 11H7.83L13.42 5.41L12 4L4 12L12 20L13.41 18.59L7.83 13H20V11Z" Foreground="White" Width="16" Height="16"/>
                </Button>
                
                <!-- Current Path Indicator -->
                <TextBlock Grid.Column="1" Text="{Binding CurrentPath}" VerticalAlignment="Center" Foreground="#AAAAAA" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                
                <!-- Action Buttons (Refresh) -->
                <Button Grid.Column="2" Command="{Binding RefreshCommand}" Background="Transparent" CornerRadius="6" Width="36" Height="36" ToolTip.Tip="Refresh">
                    <PathIcon Data="M17.65 6.35C16.2 4.9 14.21 4 12 4c-4.42 0-7.99 3.58-7.99 8s3.57 8 7.99 8c3.73 0 6.84-2.55 7.73-6h-2.08c-.82 2.33-3.04 4-5.65 4-3.31 0-6-2.69-6-6s2.69-6 6-6c1.66 0 3.14.69 4.22 1.78L13 11h7V4l-2.35 2.35z" Foreground="#4CAF50" Width="18" Height="18"/>
                </Button>
            </Grid>
        </Border>

        <!-- FILE LIST -->
        <Border Grid.Row="1" Background="#181818" CornerRadius="8" BorderBrush="#2A2A2A" BorderThickness="1">
            <ListBox ItemsSource="{Binding Files}" 
                     SelectedItem="{Binding SelectedFile}"
                     Background="Transparent"
                     SelectionMode="Single"
                     Padding="5">
                <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="models:PhoneFileItem">
                        <Grid ColumnDefinitions="Auto, *, Auto" Background="Transparent" Margin="0,4">
                            
                            <!-- File/Folder Icon -->
                            <PathIcon Grid.Column="0" Data="{Binding IconPath}" Foreground="{Binding IconColor}" Width="24" Height="24" Margin="10,0,15,0"/>
                            
                            <!-- File Name -->
                            <TextBlock Grid.Column="1" Text="{Binding Name}" Foreground="White" FontSize="15" VerticalAlignment="Center"/>
                            
                            <!-- File Size -->
                            <TextBlock Grid.Column="2" Text="{Binding FormattedSize}" Foreground="#888888" FontSize="12" VerticalAlignment="Center" Margin="0,0,10,0"/>
                            
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
                <ListBox.Styles>
                    <Style Selector="ListBoxItem:pointerover /template/ ContentPresenter">
                        <Setter Property="Background" Value="#2C2C2C"/>
                    </Style>
                    <Style Selector="ListBoxItem:selected /template/ ContentPresenter">
                        <Setter Property="Background" Value="#3D3D3D"/>
                    </Style>
                </ListBox.Styles>
            </ListBox>
        </Border>
        
    </Grid>
</UserControl>